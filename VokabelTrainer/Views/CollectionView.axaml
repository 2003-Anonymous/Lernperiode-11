<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VokabelTrainer.ViewModels"
             xmlns:models="using:VokabelTrainer.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="340" d:DesignHeight="640"
             x:Class="VokabelTrainer.Views.CollectionView"
             x:DataType="vm:CollectionViewModel">

    <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="20,24,20,20">

        <StackPanel Grid.Row="0" Spacing="2" Margin="0,0,0,14">
            <TextBlock Text="Sammlungen" Classes="title" />
            <TextBlock Text="{Binding SelectionInfo}" Classes="muted" />
        </StackPanel>

        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Collections}"
                 SelectedItem="{Binding SelectedCollection}">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="models:Collection">
                    <Border Classes="row"
                            Classes.selected="{Binding $parent[ListBoxItem].IsSelected}">
                        <TextBlock Text="{Binding Name}" FontSize="15" />
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="2" Classes="card" Margin="0,12,0,0">
            <StackPanel Spacing="8">
                <TextBox Text="{Binding NameInput}" PlaceholderText="Sammlung, z.B. Tiere" />

                <Grid ColumnDefinitions="*,Auto,Auto">
                    <Button Grid.Column="0"
                            Content="Hinzufügen"
                            Classes="primary"
                            Command="{Binding AddCommand}"
                            HorizontalAlignment="Stretch" />
                    <Button Grid.Column="1"
                            Classes="outline icon"
                            Command="{Binding RenameCommand}"
                            Margin="6,0,0,0"
                            ToolTip.Tip="Sammlung umbenennen">
                        <PathIcon Data="{StaticResource IconEdit}" Width="16" Height="16" />
                    </Button>
                    <Button Grid.Column="2"
                            Classes="danger icon"
                            Command="{Binding DeleteCommand}"
                            Margin="6,0,0,0"
                            ToolTip.Tip="Sammlung löschen">
                        <PathIcon Data="{StaticResource IconDelete}" Width="16" Height="16" />
                    </Button>
                </Grid>
            </StackPanel>
        </Border>

        <Grid Grid.Row="3" ColumnDefinitions="Auto,*" Margin="0,12,0,0">
            <Button Grid.Column="0"
                    Classes="ghost icon"
                    Command="{Binding ReturnHomeCommand}"
                    ToolTip.Tip="Zurück">
                <PathIcon Data="{StaticResource IconBack}" Width="16" Height="16" />
            </Button>
            <Button Grid.Column="1"
                    Content="Auswählen und lernen"
                    Classes="primary"
                    Command="{Binding UseCommand}"
                    HorizontalAlignment="Stretch"
                    Margin="8,0,0,0" />
        </Grid>
    </Grid>
</UserControl>
