<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VokabelTrainer.ViewModels"
             xmlns:models="using:VokabelTrainer.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="320" d:DesignHeight="660"
             x:Class="VokabelTrainer.Views.StartView"
             x:DataType="vm:StartViewModel">

    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="20">
        <TextBlock Text="Vokabeltrainer"
                   FontSize="32"
                   HorizontalAlignment="Center" />

        <ComboBox ItemsSource="{Binding Languages}"
                  SelectedItem="{Binding SelectedLanguage}"
                  HorizontalAlignment="Center"
                  MinWidth="200">
            <ComboBox.ItemTemplate>
                <DataTemplate DataType="models:Language">
                    <TextBlock Text="{Binding Name}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBlock Text="{Binding StatusText}"
                   FontSize="16"
                   Foreground="Gray"
                   HorizontalAlignment="Center" />

        <Button Content="Offene Wörter lernen"
                Command="{Binding LearnUnknownCommand}"
                HorizontalAlignment="Center"
                Padding="20,10" />
        <Button Content="Alle Wörter lernen"
                Command="{Binding LearnAllCommand}"
                HorizontalAlignment="Center"
                Padding="20,10" />
        <Button Content="Wortliste ansehen"
                Command="{Binding ShowWordListCommand}"
                HorizontalAlignment="Center"
                Padding="20,10" />
        <Button Content="Sprachen verwalten"
                Command="{Binding ShowLanguagesCommand}"
                HorizontalAlignment="Center"
                Padding="20,10" />
    </StackPanel>
</UserControl>
