<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VokabelTrainer.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="320" d:DesignHeight="660"
             x:Class="VokabelTrainer.Views.ResultView"
             x:DataType="vm:ResultViewModel">

    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="20">

        <TextBlock Text="Ergebnis"
                   FontSize="32"
                   HorizontalAlignment="Center" />

        <TextBlock Text="{Binding Summary}"
                   FontSize="24"
                   Foreground="Gray"
                   HorizontalAlignment="Center" />

        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
            <TextBlock Text="Gewusst:" FontSize="20" />
            <TextBlock Text="{Binding KnownCount}" FontSize="20" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
            <TextBlock Text="Nicht gewusst:" FontSize="20" />
            <TextBlock Text="{Binding UnknownCount}" FontSize="20" />
        </StackPanel>

        <Button Content="Home"
                Command="{Binding ReturnHomeCommand}"
                HorizontalAlignment="Center"
                Padding="20,10" />
    </StackPanel>
</UserControl>
