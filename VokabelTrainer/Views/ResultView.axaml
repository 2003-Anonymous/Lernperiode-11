<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VokabelTrainer.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="340" d:DesignHeight="640"
             x:Class="VokabelTrainer.Views.ResultView"
             x:DataType="vm:ResultViewModel">

    <Grid RowDefinitions="Auto,*,Auto" Margin="20,24,20,20">

        <TextBlock Grid.Row="0" Text="Ergebnis" Classes="title" />

        <Border Grid.Row="1" Classes="card" VerticalAlignment="Center" Margin="0,20">
            <StackPanel Spacing="18">
                <StackPanel Spacing="4">
                    <TextBlock Text="{Binding KnownCount}"
                               Classes="accent"
                               FontSize="52"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding Summary}"
                               Classes="muted"
                               HorizontalAlignment="Center"
                               TextAlignment="Center" />
                </StackPanel>

                <ProgressBar Minimum="0"
                             Maximum="{Binding TotalCount}"
                             Value="{Binding KnownCount}"
                             IsVisible="{Binding HasWords}" />

                <Grid ColumnDefinitions="*,Auto,*" IsVisible="{Binding HasWords}">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="{Binding UnknownCount}" Classes="stat" />
                        <TextBlock Text="noch offen" Classes="muted" HorizontalAlignment="Center" />
                    </StackPanel>

                    <Rectangle Grid.Column="1"
                               Width="1"
                               Fill="{StaticResource AppBorder}"
                               Margin="8,4" />

                    <StackPanel Grid.Column="2" Spacing="2">
                        <TextBlock Text="{Binding TotalCount}" Classes="stat" />
                        <TextBlock Text="abgefragt" Classes="muted" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Spacing="8">
            <Button Content="Offene Wörter weiterlernen"
                    Classes="primary"
                    Command="{Binding LearnUnknownCommand}"
                    IsVisible="{Binding CanLearnUnknown}"
                    HorizontalAlignment="Stretch" />

            <Button Content="Zur Startseite"
                    Classes="outline"
                    Command="{Binding ReturnHomeCommand}"
                    HorizontalAlignment="Stretch" />
        </StackPanel>
    </Grid>
</UserControl>
