<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VokabelTrainer.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="340" d:DesignHeight="640"
             x:Class="VokabelTrainer.Views.LearnView"
             x:DataType="vm:LearnViewModel">

    <Grid RowDefinitions="Auto,*,Auto" Margin="20,24,20,20">

        <StackPanel Grid.Row="0" Spacing="8">
            <TextBlock Text="{Binding ProgressText}" Classes="muted" />
            <ProgressBar Minimum="0"
                         Maximum="{Binding TotalCount}"
                         Value="{Binding CurrentNumber}" />
        </StackPanel>

        <Button Grid.Row="1"
                Classes="card"
                Command="{Binding ShowAnswerCommand}"
                Margin="0,20">
            <Grid RowDefinitions="*,Auto,*" Margin="20">
                <StackPanel Grid.Row="1" Spacing="16">
                    <TextBlock Text="{Binding Question}"
                               FontSize="32"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               HorizontalAlignment="Center" />

                    <Rectangle Height="1"
                               Width="40"
                               Fill="{StaticResource AppBorder}"
                               HorizontalAlignment="Center" />

                    <TextBlock Text="{Binding Answer}"
                               Classes="accent"
                               FontSize="26"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               IsVisible="{Binding AnswerVisible}" />

                    <TextBlock Text="Tippen zum Aufdecken"
                               Classes="muted"
                               HorizontalAlignment="Center"
                               IsVisible="{Binding !AnswerVisible}" />
                </StackPanel>
            </Grid>
        </Button>

        <StackPanel Grid.Row="2" Spacing="8">
            <Grid ColumnDefinitions="*,*">
                <Button Grid.Column="0"
                        Content="Nicht gewusst"
                        Classes="outline"
                        Command="{Binding NotKnownCommand}"
                        HorizontalAlignment="Stretch"
                        Margin="0,0,4,0" />
                <Button Grid.Column="1"
                        Content="Gewusst"
                        Classes="primary"
                        Command="{Binding KnownCommand}"
                        HorizontalAlignment="Stretch"
                        Margin="4,0,0,0" />
            </Grid>

            <Button Content="Überspringen"
                    Classes="ghost"
                    Command="{Binding NextCommand}"
                    HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
