<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="VokabelTrainer.App"
             xmlns:local="using:VokabelTrainer"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <Color x:Key="SystemAccentColor">#3ECF8E</Color>
        <Color x:Key="SystemAccentColorLight1">#4FE09E</Color>
        <Color x:Key="SystemAccentColorLight2">#6BE8AF</Color>
        <Color x:Key="SystemAccentColorLight3">#8CF0C3</Color>
        <Color x:Key="SystemAccentColorDark1">#2FB87A</Color>
        <Color x:Key="SystemAccentColorDark2">#249B65</Color>
        <Color x:Key="SystemAccentColorDark3">#1A7C50</Color>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://VokabelTrainer/Styles/AppTheme.axaml" />
    </Application.Styles>
</Application>
